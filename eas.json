{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "buildArtifactPaths": [
        "android/app/build/outputs/mapping/release/mapping.txt"
      ]
    }
  },
  "submit": {
    "production": {}
  }
}
